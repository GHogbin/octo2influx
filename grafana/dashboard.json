      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "refId": "export",
          "rawSql": "SELECT date_bin(INTERVAL '30 minutes', time) AS time,\n       SUM(\"kWh\") AS \"export_kWh\"\nFROM \"${usage_measurement}\"\nWHERE \"energy_type\" = 'electricity' AND \"direction\" = 'export' AND $__timeFilter(time)\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "refId": "export_unit_rate",
          "rawSql": "WITH rates AS (\n  SELECT date_bin_gapfill(INTERVAL '30 minutes', time) AS time,\n         \"price_type\",\n         locf(avg(\"p/kWh_inc_vat\")) / 100.0 AS \"export-unit-rate_£/kWh\"\n  FROM \"${tariffs_measurement}\"\n  WHERE \"energy_type\" = 'electricity' AND \"direction\" = 'export'\n    AND \"price_type\" IN ('standard-unit-rates', 'day-unit-rates', 'night-unit-rates', 'ev-device-off-peak-unit-rates', 'ev-device-peak-unit-rates')\n    AND \"tariff_code\" = '${electricity_export_tariff}'\n    AND time >= $__timeFrom - INTERVAL '2 days'\n    AND time <= $__timeTo\n  GROUP BY 1, \"price_type\"\n)\nSELECT * FROM rates\nWHERE time >= date_bin(INTERVAL '30 minutes', $__timeFrom)\nORDER BY time",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "hide": false
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "refId": "import",
          "rawSql": "SELECT date_bin(INTERVAL '30 minutes', time) AS time,\n       SUM(\"kWh\") AS \"import_kWh\"\nFROM \"${usage_measurement}\"\nWHERE \"energy_type\" = 'electricity' AND \"direction\" = 'import' AND $__timeFilter(time)\nGROUP BY 1\nORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "hide": false
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "refId": "import_unit_rate",
          "rawSql": "WITH rates AS (\n  SELECT date_bin_gapfill(INTERVAL '30 minutes', time) AS time,\n         \"price_type\",\n         locf(avg(\"p/kWh_inc_vat\")) / 100.0 AS \"import-unit-rate_£/kWh\"\n  FROM \"${tariffs_measurement}\"\n  WHERE \"energy_type\" = 'electricity' AND \"direction\" = 'import'\n    AND \"price_type\" IN ('standard-unit-rates', 'day-unit-rates', 'night-unit-rates', 'ev-device-off-peak-unit-rates', 'ev-device-peak-unit-rates')\n    AND \"tariff_code\" = '${electricity_import_tariff}'\n    AND time >= $__timeFrom - INTERVAL '2 days'\n    AND time <= $__timeTo\n  GROUP BY 1, \"price_type\"\n)\nSELECT * FROM rates\nWHERE time >= date_bin(INTERVAL '30 minutes', $__timeFrom)\nORDER BY time",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "hide": false
        }
