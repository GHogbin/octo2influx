          "rawSql": "SELECT\n  COALESCE(SUM(CASE WHEN \"cost_type\" = 'standing' THEN \"value_gbp\" ELSE 0.0 END), 0.0) AS \"Standing charge cost\",\n  COALESCE(SUM(CASE WHEN \"cost_type\" = 'usage' THEN \"value_gbp\" ELSE 0.0 END), 0.0) AS \"Usage cost\",\n  COALESCE(SUM(\"value_gbp\"), 0.0) AS \"Total cost\"\nFROM \"${cost_measurement}\"\nWHERE \"energy_type\" = 'electricity'\n  AND \"direction\" = 'import'\n  AND \"tariff_code\" = '${electricity_import_tariff}'\n  AND \"cost_type\" IN ('usage', 'standing')\n  AND $__timeFilter(time)",
